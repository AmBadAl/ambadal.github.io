@inproceedings{bagheridelouee2024metric,
  title={Metric Distortion Under Public-Spirited Voting},
  author={Bagheridelouee, Amirreza and Nilipour, Marzie and Seddighin, Masoud and Shamsipour, Maziar},
  booktitle={Proceedings of the 23rd International Conference on Autonomous Agents and Multiagent Systems},
  pages={2144--2146},
  year={2024},
  abbr={AAMAS},
  abstract={We investigate how public-spirited voting affects distortion in the metric framework. Using the public-spirited model introduced by Flanigan et al., we evaluate Plurality, Borda, Copeland, Veto, k-approval, and PluralityVeto. We establish a general lower bound for any voting rule and derive rule-specific lower and upper bounds. When all voters exhibit the same degree of public-spiritedness, PluralityVeto matches the general lower bound.},
  pdf={https://ifaamas.org/Proceedings/aamas2024/pdfs/p2144.pdf},
  bibtex_show={true}
}
